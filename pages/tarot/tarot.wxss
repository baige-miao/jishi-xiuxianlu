/**
 * 塔罗牌占卜页面样式
 * 支持三种牌阵，翻牌动画效果
 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* 页面头部 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 0;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--dim);
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 20rpx;
}

/* ===== 牌阵选择 ===== */
.spread-section {
  margin-bottom: 40rpx;
}

.spread-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spread-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.spread-card.active {
  border-color: var(--accent);
  background: var(--accent-alpha-bg);
}

.spread-icon {
  font-size: 40rpx;
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.spread-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4rpx;
}

.spread-desc {
  font-size: 24rpx;
  color: var(--dim);
}

/* ===== 问题输入 ===== */
.question-section {
  margin-bottom: 40rpx;
}

.question-input {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ===== 操作按钮 ===== */
.action-section {
  margin-bottom: 40rpx;
}

.btn-divination {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  letter-spacing: 4rpx;
}

.btn-divination[disabled] {
  opacity: 0.5;
}

/* ===== 结果展示 ===== */
.result-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.result-question {
  font-size: 26rpx;
  color: var(--dim);
}

/* ===== 牌面网格 ===== */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

/* 单张牌布局 */
.cards-grid.single {
  justify-content: center;
}

.cards-grid.single .card-wrapper {
  width: 240rpx;
  height: 360rpx;
}

/* 三张牌布局 */
.cards-grid.threeCard {
  justify-content: center;
}

.cards-grid.threeCard .card-wrapper {
  width: 200rpx;
  height: 300rpx;
}

/* 凯尔特十字布局 */
.cards-grid.celticCross {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.cards-grid.celticCross .card-wrapper {
  width: 100%;
  height: 200rpx;
}

/* ===== 牌面样式 ===== */
.card-wrapper {
  position: relative;
  perspective: 1000rpx;
  cursor: pointer;
}

.card-back,
.card-front {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  transition: transform 0.6s ease;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 牌背 */
.card-back {
  background: linear-gradient(135deg, #2d1b69, #11998e);
  border: 2rpx solid #4a3f8a;
  transform: rotateY(0deg);
}

.card-back-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.card-back-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 牌面 */
.card-front {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border: 2rpx solid #0f3460;
  transform: rotateY(180deg);
  padding: 12rpx;
}

/* 翻牌动画 */
.card-wrapper.flipped .card-back {
  transform: rotateY(180deg);
}

.card-wrapper.flipped .card-front {
  transform: rotateY(0deg);
}

/* 逆位旋转 */
.card-wrapper.reversed .card-front {
  transform: rotateY(180deg) rotate(180deg);
}

.card-wrapper.reversed.flipped .card-front {
  transform: rotateY(0deg) rotate(180deg);
}

/* 牌面内容 */
.card-position {
  font-size: 16rpx;
  color: var(--accent);
  margin-bottom: 4rpx;
  text-align: center;
}

.card-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.card-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 4rpx;
}

.card-orientation {
  font-size: 18rpx;
  color: var(--accent2);
}

/* ===== 解读结果 ===== */
.reading-section {
  margin-bottom: 40rpx;
}

.reading-content {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
}

.reading-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.reading-item:last-child {
  border-bottom: none;
}

.reading-position {
  font-size: 24rpx;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.reading-card {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.reading-meaning {
  font-size: 24rpx;
  color: var(--dim);
  line-height: 1.6;
}

/* ===== 操作按钮 ===== */
.result-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.btn-copy,
.btn-reset {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-copy {
  background: var(--accent);
  color: #ffffff;
}

.btn-reset {
  background: transparent;
  border: 1rpx solid var(--border);
  color: var(--text);
}
