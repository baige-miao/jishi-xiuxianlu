/**
 * 生活页面样式
 * 整合日记、统计、日志和书本功能
 */

.container {
  padding: 0 24rpx;
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

/* 银河全屏背景 */
.galaxy-full {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 15% 25%, rgba(30,64,175,0.45) 0%, transparent 50%),
    radial-gradient(ellipse at 75% 15%, rgba(88,28,135,0.4) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 50%, rgba(59,130,246,0.18) 0%, transparent 60%),
    radial-gradient(ellipse at 20% 70%, rgba(124,58,237,0.25) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 65%, rgba(14,116,144,0.2) 0%, transparent 45%),
    radial-gradient(ellipse at 45% 85%, rgba(99,102,241,0.15) 0%, transparent 50%),
    linear-gradient(180deg, #020617 0%, #030712 40%, #0c0a1a 70%, #0f0520 100%);
}

/* ===== 标签页 ===== */
.tabs {
  display: flex;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
  z-index: 2;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--dim);
  transition: all 0.3s ease;
}

.tab.active {
  background: var(--accent-alpha-bg);
  color: var(--accent);
  font-weight: 600;
}

/* 星河页标签透明 */
.tabs-galaxy {
  background: transparent;
  border-color: rgba(255,255,255,0.08);
}

.tabs-galaxy .tab {
  color: rgba(255,255,255,0.45);
}

.tabs-galaxy .tab.active {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.9);
}

.divider-galaxy {
  background: rgba(255,255,255,0.06);
}

.tab-icon { font-size: 32rpx; }
.tab-text { font-size: 28rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 0 0 16rpx;
  position: relative;
  z-index: 2;
}

/* 书架样式 */

/* 标签内容区 */
.tab-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 0;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

/* ===== 日记标签 ===== */

/* 日期导航 */
.diary-date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.date-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--text);
}

.date-nav-current {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-nav-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.date-nav-label {
  font-size: 22rpx;
  color: var(--accent);
  margin-top: 4rpx;
}

/* 心情和天气选择器 */
.diary-mood-weather {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.mood-selector,
.weather-selector {
  flex: 1;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 16rpx;
}

.selector-label {
  font-size: 22rpx;
  color: var(--dim);
  margin-bottom: 8rpx;
  display: block;
}

.emoji-options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.emoji-opt {
  font-size: 36rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  opacity: 0.5;
  transition: all 0.2s ease;
}

.emoji-opt.selected {
  opacity: 1;
  background: var(--accent-alpha-bg);
  transform: scale(1.15);
}

/* 日记区块 */
.diary-section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.diary-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.diary-auto-summary {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
  padding: 16rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.diary-content-area {
  min-height: 120rpx;
  padding: 16rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.diary-content-text {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  white-space: pre-wrap;
}

.diary-content-placeholder {
  font-size: 26rpx;
  color: var(--dim);
}

.diary-save-status {
  text-align: center;
  font-size: 22rpx;
  color: var(--success);
  margin-bottom: 16rpx;
}

/* 翻书入口 */
.book-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.book-entry-icon {
  font-size: 36rpx;
}

.book-entry-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.book-entry-arrow {
  font-size: 28rpx;
  color: var(--dim);
}

/* ===== 备忘录内嵌 ===== */
.memo-loading {
  text-align: center;
  color: var(--dim);
  font-size: 24rpx;
  padding: 20rpx 0;
}

.memo-empty {
  text-align: center;
  color: var(--dim);
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* 心情日历 */
.mood-section {
  margin-bottom: 16rpx;
}

.mood-month-label {
  font-size: 22rpx;
  color: var(--dim);
  margin-left: auto;
}

.mood-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.mood-weekday {
  text-align: center;
  font-size: 20rpx;
  color: var(--dim);
  padding: 4rpx 0;
}

.mood-calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}

.mood-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
  border-radius: 8rpx;
  min-height: 64rpx;
}

.mood-day.other-month {
  opacity: 0.3;
}

.mood-day.today {
  background: var(--accent-alpha-bg);
  border: 1rpx solid var(--accent-alpha-border);
}

.mood-day-num {
  font-size: 20rpx;
  color: var(--dim);
  line-height: 1;
}

.mood-day-emoji {
  font-size: 28rpx;
  line-height: 1.2;
  margin-top: 2rpx;
}

.mood-day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--border);
  margin-top: 4rpx;
}

.mood-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.mood-summary-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.mood-summary-emoji {
  font-size: 28rpx;
}

.mood-summary-count {
  font-size: 22rpx;
  color: var(--dim);
}

.memo-add-btn {
  background: var(--accent);
  color: var(--btn-text);
  border: none;
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  margin: 0;
}

.memo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.memo-card-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
}

.memo-card {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  transition: transform 0.25s ease;
  position: relative;
  z-index: 1;
}

.memo-card.swiped {
  transform: translateX(-140rpx);
}

.memo-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memo-preview {
  font-size: 22rpx;
  color: var(--dim);
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.memo-time {
  font-size: 20rpx;
  color: var(--dim);
  text-align: right;
}

.memo-delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #ef5350;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 0 12rpx 12rpx 0;
  z-index: 0;
}

/* 备忘录全屏编辑器 */
.memo-editor-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--bg);
  z-index: 200;
  display: flex;
  flex-direction: column;
}

.memo-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border);
}

.memo-editor-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.5;
}

.memo-editor-cancel {
  background: transparent;
  color: var(--dim);
}

.memo-editor-save {
  background: var(--accent);
  color: var(--btn-text);
  font-weight: 600;
}

.memo-editor-status {
  font-size: 22rpx;
  color: var(--dim);
}

.memo-editor-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  padding: 24rpx 24rpx 16rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
}

.memo-editor-content {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  padding: 24rpx;
  background: var(--bg);
  line-height: 1.8;
  width: 100%;
  box-sizing: border-box;
}

/* ===== 银河书本 ===== */
.book-tab {
  position: relative;
  overflow: hidden;
  height: 100%;
}

.book-tab-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  overflow-y: auto;
  padding: 20rpx 24rpx 60rpx;
}

.book-tab-inner .empty {
  text-align: center;
  padding: 160rpx 40rpx 80rpx;
  color: rgba(255,255,255,0.5);
}

.book-tab-inner .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  display: block;
}

.book-tab-inner .empty-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
  display: block;
}

.book-tab-inner .loading {
  text-align: center;
  padding: 160rpx 40rpx;
  color: rgba(255,255,255,0.4);
  font-size: 26rpx;
}

/* 银河背景（已迁移至 .galaxy-full） */

/* ===== 深空银河 · 完整重写 ===== */

/* 星星层 */
.stars-layer {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.star {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 6rpx rgba(200,210,255,0.9), 0 0 12rpx rgba(180,190,255,0.4);
}

/* 星星闪烁 */
@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.6); }
}

