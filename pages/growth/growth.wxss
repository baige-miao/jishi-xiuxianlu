/* === 银河带：宽幅、明亮、多层 === */
.milky-way {
  position: absolute;
  top: -35%;
  left: -50%;
  width: 220%;
  height: 80%;
  background:
    radial-gradient(ellipse 100% 50% at 50% 50%, rgba(100,130,255,0.35) 0%, rgba(80,100,200,0.2) 30%, transparent 70%),
    linear-gradient(
      135deg,
      transparent 0%,
      rgba(60,80,160,0.08) 10%,
      rgba(80,100,200,0.18) 22%,
      rgba(100,130,220,0.3) 35%,
      rgba(130,150,240,0.45) 45%,
      rgba(160,180,255,0.55) 50%,
      rgba(130,150,240,0.45) 55%,
      rgba(100,130,220,0.3) 65%,
      rgba(80,100,200,0.18) 78%,
      rgba(60,80,160,0.08) 90%,
      transparent 100%
    );
  transform: rotate(-28deg);
  filter: blur(25rpx);
  animation: milkyPulse 10s ease-in-out infinite;
}

.milky-way-core {
  position: absolute;
  top: -20%;
  left: -35%;
  width: 180%;
  height: 50%;
  background:
    radial-gradient(ellipse 80% 40% at 50% 50%, rgba(180,200,255,0.5) 0%, rgba(140,160,240,0.25) 40%, transparent 70%),
    linear-gradient(
      135deg,
      transparent 0%,
      rgba(140,160,240,0.12) 25%,
      rgba(180,200,255,0.3) 42%,
      rgba(210,220,255,0.5) 50%,
      rgba(180,200,255,0.3) 58%,
      rgba(140,160,240,0.12) 75%,
      transparent 100%
    );
  transform: rotate(-28deg);
  filter: blur(12rpx);
  animation: milkyPulse 10s ease-in-out infinite 1.5s;
}

@keyframes milkyPulse {
  0%, 100% { opacity: 0.6; }
  50%      { opacity: 1; }
}

/* === 星团：更大更亮 === */
.star-cluster {
  position: absolute;
  border-radius: 50%;
}

.sc1 {
  width: 260rpx; height: 260rpx;
  top: 10%; left: 55%;
  background:
    radial-gradient(circle, rgba(200,210,255,0.6) 0%, rgba(160,180,255,0.3) 25%, rgba(120,140,220,0.1) 50%, transparent 70%);
  filter: blur(4rpx);
  animation: clusterPulse 6s ease-in-out infinite;
}

.sc2 {
  width: 200rpx; height: 200rpx;
  top: 50%; left: 12%;
  background:
    radial-gradient(circle, rgba(180,200,255,0.5) 0%, rgba(140,160,240,0.25) 25%, rgba(100,120,200,0.08) 50%, transparent 70%);
  filter: blur(3rpx);
  animation: clusterPulse 8s ease-in-out infinite 2s;
}

.sc3 {
  width: 160rpx; height: 160rpx;
  top: 70%; left: 72%;
  background:
    radial-gradient(circle, rgba(220,225,255,0.45) 0%, rgba(180,190,255,0.2) 25%, rgba(140,150,220,0.06) 50%, transparent 70%);
  filter: blur(3rpx);
  animation: clusterPulse 7s ease-in-out infinite 3.5s;
}

@keyframes clusterPulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.15); }
}

/* === 流星：更长尾迹 === */
.shooting-star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 8rpx rgba(255,255,255,0.8);
}

.shooting-star::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 180rpx;
  height: 2rpx;
  background: linear-gradient(to left, rgba(255,255,255,0.9), rgba(180,200,255,0.4), transparent);
  transform-origin: right center;
}

.ss1 {
  top: 8%; left: 25%;
  animation: shootingStar 4s ease-in-out infinite 1s;
}

.ss2 {
  top: 22%; left: 55%;
  animation: shootingStar 5s ease-in-out infinite 4s;
}

.ss3 {
  top: 5%; left: 78%;
  animation: shootingStar 6s ease-in-out infinite 7s;
}

@keyframes shootingStar {
  0%   { opacity: 0; transform: translate(0, 0) rotate(-32deg); }
  2%   { opacity: 1; }
  8%   { opacity: 1; transform: translate(-280rpx, 160rpx) rotate(-32deg); }
  10%  { opacity: 0; transform: translate(-340rpx, 195rpx) rotate(-32deg); }
  100% { opacity: 0; }
}

/* === 星云：多层径向渐变，更绚丽 === */
.nebula {
  position: absolute;
  border-radius: 50%;
}

/* 蓝紫星云 - 左上 */
.n1 {
  width: 700rpx; height: 550rpx;
  top: -5%; left: -15%;
  background:
    radial-gradient(ellipse 60% 50% at 40% 45%, rgba(59,130,246,0.5) 0%, transparent 60%),
    radial-gradient(ellipse 45% 40% at 60% 55%, rgba(124,58,237,0.4) 0%, transparent 55%),
    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(79,70,229,0.25) 0%, transparent 70%);
  filter: blur(50rpx);
  animation: nebulaDrift1 28s ease-in-out infinite;
}

/* 深紫星云 - 右中 */
.n2 {
  width: 650rpx; height: 500rpx;
  top: 35%; right: -20%;
  background:
    radial-gradient(ellipse 55% 50% at 50% 40%, rgba(139,92,246,0.5) 0%, transparent 55%),
    radial-gradient(ellipse 40% 35% at 40% 60%, rgba(168,85,247,0.35) 0%, transparent 50%),
    radial-gradient(ellipse 65% 55% at 55% 50%, rgba(109,40,217,0.2) 0%, transparent 65%);
  filter: blur(55rpx);
  animation: nebulaDrift2 32s ease-in-out infinite reverse;
}

/* 青蓝星云 - 下方 */
.n3 {
  width: 600rpx; height: 450rpx;
  bottom: -10%; left: 10%;
  background:
    radial-gradient(ellipse 50% 45% at 45% 50%, rgba(14,116,144,0.45) 0%, transparent 55%),
    radial-gradient(ellipse 40% 35% at 55% 45%, rgba(6,182,212,0.3) 0%, transparent 50%),
    radial-gradient(ellipse 60% 50% at 50% 55%, rgba(8,145,178,0.18) 0%, transparent 65%);
  filter: blur(45rpx);
  animation: nebulaDrift1 24s ease-in-out infinite 5s;
}

/* 靛蓝星云 - 右上 */
.n4 {
  width: 550rpx; height: 420rpx;
  top: 5%; right: 5%;
  background:
    radial-gradient(ellipse 50% 45% at 50% 45%, rgba(99,102,241,0.4) 0%, transparent 55%),
    radial-gradient(ellipse 35% 30% at 45% 55%, rgba(129,140,248,0.25) 0%, transparent 50%),
    radial-gradient(ellipse 55% 48% at 50% 50%, rgba(79,70,229,0.15) 0%, transparent 65%);
  filter: blur(50rpx);
  animation: nebulaDrift2 26s ease-in-out infinite 3s;
}

/* 暗紫星云 - 左下 */
.n5 {
  width: 500rpx; height: 380rpx;
  bottom: 15%; left: -8%;
  background:
    radial-gradient(ellipse 45% 40% at 50% 50%, rgba(88,28,135,0.4) 0%, transparent 55%),
    radial-gradient(ellipse 35% 30% at 55% 45%, rgba(147,51,234,0.25) 0%, transparent 50%),
    radial-gradient(ellipse 55% 45% at 48% 52%, rgba(109,40,217,0.15) 0%, transparent 65%);
  filter: blur(48rpx);
  animation: nebulaDrift1 30s ease-in-out infinite 8s;
}

@keyframes nebulaDrift1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25%      { transform: translate(40rpx, -25rpx) scale(1.06); }
  50%      { transform: translate(-20rpx, 15rpx) scale(0.96); }
  75%      { transform: translate(25rpx, 10rpx) scale(1.03); }
}

@keyframes nebulaDrift2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  30%      { transform: translate(-35rpx, 20rpx) scale(1.05); }
  60%      { transform: translate(25rpx, -15rpx) scale(0.97); }
}

/* 浮动粒子 */
.particles {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation: particleRise linear infinite;
}

.p1 { width: 10rpx; height: 10rpx; left: 8%;  background: rgba(59,130,246,0.7);  animation-duration: 20s; animation-delay: 0s; }
.p2 { width: 6rpx;  height: 6rpx;  left: 22%; background: rgba(139,92,246,0.8);  animation-duration: 24s; animation-delay: 3s; }
.p3 { width: 14rpx; height: 14rpx; left: 38%; background: rgba(99,102,241,0.6);  animation-duration: 22s; animation-delay: 1s; }
.p4 { width: 8rpx;  height: 8rpx;  left: 52%; background: rgba(124,58,237,0.7);  animation-duration: 18s; animation-delay: 5s; }
.p5 { width: 6rpx;  height: 6rpx;  left: 68%; background: rgba(14,116,144,0.8);  animation-duration: 26s; animation-delay: 2s; }
.p6 { width: 12rpx; height: 12rpx; left: 82%; background: rgba(79,70,229,0.6);   animation-duration: 21s; animation-delay: 4s; }
.p7 { width: 8rpx;  height: 8rpx;  left: 15%; background: rgba(6,182,212,0.7);   animation-duration: 23s; animation-delay: 6s; }
.p8 { width: 10rpx; height: 10rpx; left: 60%; background: rgba(168,85,247,0.8);  animation-duration: 19s; animation-delay: 0.5s; }
.p9 { width: 6rpx;  height: 6rpx;  left: 45%; background: rgba(59,130,246,0.6);  animation-duration: 25s; animation-delay: 2.5s; }
.p10{ width: 8rpx;  height: 8rpx;  left: 75%; background: rgba(139,92,246,0.7);  animation-duration: 20s; animation-delay: 4.5s; }

@keyframes particleRise {
  0%   { transform: translateY(0) scale(0); opacity: 0; }
  8%   { opacity: 0.7; transform: scale(1); }
  92%  { opacity: 0.7; }
  100% { transform: translateY(-110vh) scale(0.5); opacity: 0; }
}

/* 气泡年份 */
.bubble-year {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.7);
  margin: 20rpx 0 12rpx 8rpx;
  letter-spacing: 2rpx;
}

.bubble-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

/* 日记气泡 */
.diary-bubble {
  position: relative;
  width: calc(33.333% - 16rpx);
  aspect-ratio: 1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bubbleFloat 5s ease-in-out infinite;
  transition: transform 0.2s ease;
}

.diary-bubble:active {
  transform: scale(0.92) !important;
}

/* 气泡飞出 */
.diary-bubble.popping {
  animation: bubblePop 0.5s cubic-bezier(0.23, 1, 0.32, 1) forwards !important;
}

@keyframes bubbleFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-12rpx); }
}

@keyframes bubblePop {
  0%   { transform: scale(1); opacity: 1; }
  40%  { transform: scale(1.2); opacity: 0.9; }
  100% { transform: scale(0.1); opacity: 0; }
}

/* 气泡光晕 */
.bubble-glow {
  position: absolute;
  top: -15%; left: -15%;
  width: 130%; height: 130%;
  border-radius: 50%;
  filter: blur(25rpx);
  opacity: 0.2;
  animation: glowPulse 4s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.15; transform: scale(1); }
  50%      { opacity: 0.3;  transform: scale(1.08); }
}

/* 气泡内部 */
.bubble-inner {
  position: relative;
  z-index: 1;
  width: 82%;
  height: 82%;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow:
    inset 0 0 30rpx rgba(255,255,255,0.05),
    0 4rpx 20rpx rgba(0,0,0,0.3);
}

.bubble-emoji {
  font-size: 32rpx;
}

.bubble-label {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.bubble-count {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 阅读视图：沉浸式 ===== */
.reading-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background:
    radial-gradient(ellipse at 15% 25%, rgba(30,64,175,0.4) 0%, transparent 50%),
    radial-gradient(ellipse at 75% 15%, rgba(88,28,135,0.35) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 50%, rgba(59,130,246,0.15) 0%, transparent 60%),
    radial-gradient(ellipse at 20% 70%, rgba(124,58,237,0.2) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 65%, rgba(14,116,144,0.18) 0%, transparent 45%),
    linear-gradient(180deg, #020617 0%, #030712 40%, #0c0a1a 70%, #0f0520 100%);
  z-index: 200;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.reading-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.reading-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

/* 阅读页粒子 */
.reading-particles {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.rp {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,215,0,0.5);
  opacity: 0;
  animation: rpFloat linear infinite;
}

.rp1 { width: 6rpx;  height: 6rpx;  left: 8%;  animation-duration: 14s; animation-delay: 0s; }
.rp2 { width: 4rpx;  height: 4rpx;  left: 22%; animation-duration: 18s; animation-delay: 2s; }
.rp3 { width: 8rpx;  height: 8rpx;  left: 38%; animation-duration: 12s; animation-delay: 1s; }
.rp4 { width: 5rpx;  height: 5rpx;  left: 52%; animation-duration: 16s; animation-delay: 4s; }
.rp5 { width: 4rpx;  height: 4rpx;  left: 68%; animation-duration: 20s; animation-delay: 0.5s; }
.rp6 { width: 7rpx;  height: 7rpx;  left: 80%; animation-duration: 13s; animation-delay: 3s; }
.rp7 { width: 5rpx;  height: 5rpx;  left: 92%; animation-duration: 17s; animation-delay: 1.5s; }
.rp8 { width: 6rpx;  height: 6rpx;  left: 45%; animation-duration: 15s; animation-delay: 5s; }

@keyframes rpFloat {
  0%   { transform: translateY(105vh) scale(0); opacity: 0; }
  8%   { opacity: 0.7; transform: scale(1); }
  92%  { opacity: 0.7; }
  100% { transform: translateY(-10vh) scale(0.4); opacity: 0; }
}

/* 导航栏 */
.reading-nav {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  position: relative;
  z-index: 10;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  padding: 8rpx 0;
}

.nav-back:active {
  color: rgba(255,255,255,0.9);
}

.nav-arrow {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  display: block;
}

.nav-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  display: block;
  margin-top: 2rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 阅读主体 */
.reading-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx 32rpx;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

/* 毛玻璃卡片 */
.glass-card {
  width: 100%;
  max-width: 680rpx;
  height: 100%;
  max-height: 1050rpx;
  background: rgba(15,10,35,0.75);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  backdrop-filter: blur(20px);
  box-shadow:
    0 16rpx 64rpx rgba(0,0,0,0.4),
    inset 0 1rpx 0 rgba(255,255,255,0.08);
  animation: cardAppear 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

@keyframes cardAppear {
  0%   { transform: scale(0.85) translateY(40rpx); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

/* 卡片顶部光晕 */
.gc-glow {
  position: absolute;
  top: -60rpx; left: 50%;
  width: 300rpx; height: 200rpx;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(139,92,246,0.25) 0%, transparent 70%);
  pointer-events: none;
}

.gc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.gc-date {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
}

.gc-emoji {
  font-size: 32rpx;
}

.gc-divider {
  height: 1rpx;
  margin: 0 32rpx 8rpx;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.2) 20%, rgba(255,255,255,0.2) 80%, transparent);
}

.gc-body {
  flex: 1;
  width: 100%;
  padding: 12rpx 32rpx;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.gc-summary {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(139,92,246,0.1);
  border-left: 4rpx solid rgba(139,92,246,0.5);
  border-radius: 0 12rpx 12rpx 0;
}

.gc-summary-label {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(180,160,255,0.95);
  display: block;
  margin-bottom: 8rpx;
}

.gc-content {
  font-size: 28rpx;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.gc-empty {
  text-align: center;
  color: rgba(255,255,255,0.25);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 星光文字效果 */
.starlight-text {
  color: #fff;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,1) 0%,
    rgba(255,230,150,1) 25%,
    rgba(255,255,255,1) 50%,
    rgba(180,170,255,1) 75%,
    rgba(255,255,255,1) 100%
  );
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: starShimmer 6s linear infinite;
}

@keyframes starShimmer {
  0%   { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 页码 */
.gc-footer {
  padding: 10rpx 0 20rpx;
}

.gc-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.gc-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  transition: all 0.3s ease;
}

.gc-dot.active {
  width: 22rpx;
  border-radius: 4rpx;
  background: rgba(139,92,246,0.8);
}

.gc-dot.more {
  width: 8rpx;
  border-radius: 50%;
}

/* 滑动翻页 */
.glass-card.slide-left {
  animation: glassSlideLeft 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.glass-card.slide-right {
  animation: glassSlideRight 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes glassSlideLeft {
  0%   { transform: translateX(0); opacity: 1; }
  100% { transform: translateX(-80rpx); opacity: 0; }
}

@keyframes glassSlideRight {
  0%   { transform: translateX(0); opacity: 1; }
  100% { transform: translateX(80rpx); opacity: 0; }
}


/* ===== 全屏编辑器 ===== */
.editor-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--bg);
  z-index: 200;
  display: flex;
  flex-direction: column;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.editor-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.editor-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.editor-cancel {
  background: transparent;
  color: var(--dim);
}

.editor-save {
  background: var(--accent);
  color: var(--btn-text);
  font-weight: 600;
}

.editor-textarea-wrap {
  flex: 1;
  padding: 24rpx;
  overflow: hidden;
}

.editor-textarea {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.8;
  background: transparent;
  box-sizing: border-box;
}

.editor-count {
  text-align: right;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: var(--dim);
  border-top: 1rpx solid var(--border);
}

/* ===== 统计内容 ===== */
.stat-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  padding: 12rpx 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--accent);
}

.stat-label {
  font-size: 18rpx;
  color: var(--dim);
  margin-top: 2rpx;
}

.section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

/* TOP5 */
.top5-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.top5-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top5-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--btn-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.top5-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

.top5-count {
  font-size: 22rpx;
  color: var(--dim);
  flex-shrink: 0;
  width: 80rpx;
  text-align: right;
}

.top5-bar {
  width: 120rpx;
  height: 10rpx;
  background: var(--border);
  border-radius: 5rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.top5-bar-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 5rpx;
}

.empty-small {
  text-align: center;
  color: var(--dim);
  font-size: 24rpx;
  padding: 20rpx;
}

/* 图表区 */
.chart-area { overflow-x: auto; }

.growth-canvas {
  display: block;
  margin: 0 auto;
}

.chart-x-labels {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 16rpx 0;
}

.chart-x-label {
  font-size: 18rpx;
  color: var(--dim);
  text-align: center;
  flex: 1;
}

.chart-bars {
  display: flex;
  gap: 8rpx;
  min-height: 200rpx;
  align-items: flex-end;
}

.chart-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 40rpx;
}

.chart-bar-wrapper {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 80%;
  background: linear-gradient(to top, var(--accent), var(--accent2));
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.chart-date {
  font-size: 16rpx;
  color: var(--dim);
  margin-top: 6rpx;
  white-space: nowrap;
}

.chart-value {
  font-size: 18rpx;
  color: var(--accent);
  font-weight: 600;
}

/* 评级进度 */
.rating-current {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rating-current-label { font-size: 24rpx; color: var(--dim); }
.rating-current-value { font-size: 36rpx; font-weight: 900; color: var(--accent2); }
.rating-current-sum { font-size: 24rpx; color: var(--dim); }

.rating-bar-section { margin-bottom: 20rpx; }

.rating-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--dim);
  margin-bottom: 6rpx;
}

.rating-bar-outer {
  height: 14rpx;
  background: var(--border);
  border-radius: 7rpx;
  overflow: hidden;
}

.rating-bar-inner {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, var(--accent2), var(--accent));
  transition: width 0.4s ease;
}

.rating-bar-pct {
  text-align: right;
  font-size: 20rpx;
  color: var(--dim);
  margin-top: 4rpx;
}

.rating-tiers {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.rating-tier {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--border);
  background: var(--card-bg);
  min-width: 80rpx;
}

.rating-tier.active {
  border-color: var(--accent2);
  background: var(--accent2-alpha-bg);
}

.tier-label { font-size: 22rpx; font-weight: 600; color: var(--text); }
.tier-range { font-size: 16rpx; color: var(--dim); }

/* ===== 日志内容 ===== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--dim);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--dim);
  margin-top: 8rpx;
  display: block;
}

.log-day { margin-bottom: 30rpx; }

.log-day-header {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent2);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 12rpx;
}

.log-entry {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.log-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent-alpha-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
}

.log-body { flex: 1; }
.log-task-name { font-weight: 600; font-size: 26rpx; color: var(--text); }
.log-changes { font-size: 22rpx; color: var(--success); margin-top: 4rpx; }
