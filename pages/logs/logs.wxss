/**
 * 日志页样式
 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: var(--accent);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--dim);
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--dim);
  margin-top: 8rpx;
  display: block;
}

/* 日志日分组 */
.log-day {
  margin-bottom: 30rpx;
}
.log-day-header {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent2);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 12rpx;
}

/* 日志条目 */
.log-entry {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}
.log-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent-alpha-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
}
.log-body {
  flex: 1;
}
.log-task-name {
  font-weight: 600;
  font-size: 26rpx;
  color: var(--text);
}
.log-changes {
  font-size: 22rpx;
  color: var(--success);
  margin-top: 4rpx;
}
