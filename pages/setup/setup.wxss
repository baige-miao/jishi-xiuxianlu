/**
 * 设置页样式
 *
 * 更新说明：
 * - 新增模式选择样式
 * - 新增全屏遮罩引导样式
 */

.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* 标题区 */
.hero {
  text-align: center;
  padding: 60rpx 0 30rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  color: transparent;
}
.hero-sub {
  color: var(--dim);
  font-size: 26rpx;
  margin-top: 10rpx;
}

/* 步骤条 */
.steps {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 30rpx 0;
}
.step-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  color: var(--dim);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 26rpx;
}
.step-dot.active {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(0, 212, 170, 0.1);
}
.step-dot.done {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--btn-text);
}
.step-line {
  width: 60rpx;
  height: 4rpx;
  background: var(--border);
  margin: 0 8rpx;
}
.step-line.done {
  background: var(--accent);
}

/* 卡片 */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: var(--accent);
}
.hint {
  color: var(--dim);
  font-size: 24rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* 表单 */
.form-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.form-group {
  display: flex;
  flex-direction: column;
}
.form-label {
  font-size: 24rpx;
  color: var(--dim);
  margin-bottom: 8rpx;
}
.form-input {
  padding: 16rpx 20rpx;
  background: var(--input-bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 26rpx;
}
.flex1 { flex: 1; min-width: 120rpx; }
.flex2 { flex: 2; min-width: 200rpx; }
.flex3 { flex: 3; min-width: 280rpx; }

/* 选择器 */
.picker-text {
  padding: 16rpx 20rpx;
  background: var(--input-bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 26rpx;
}

/* 属性行 */
.attr-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 12rpx;
  background: var(--input-bg);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.attr-value-input {
  width: 120rpx;
  flex: none;
}

/* 任务行 */
.task-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
  flex-wrap: wrap;
  padding: 12rpx;
  background: var(--input-bg);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 删除按钮 */
.btn-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 按钮 */
.btn-primary {
  background: var(--accent);
  color: var(--btn-text);
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-outline {
  background: transparent;
  border: 1rpx solid var(--accent);
  color: var(--accent);
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}
.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.btn-large {
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  margin-top: 24rpx;
}
.btn-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 30rpx;
}

/* 预设模板 */
.templates {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.tpl-btn {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--border);
  background: var(--input-bg);
  color: var(--text);
  font-size: 24rpx;
}

/* 摘要 */
.summary {
  margin: 24rpx 0;
  color: var(--dim);
  font-size: 28rpx;
}
.bold {
  font-weight: 700;
  color: var(--text);
}

/* 步骤区 */
.step-section {
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 主题选择卡片 */
.theme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.theme-card {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  text-align: center;
  transition: all 0.2s;
}
.theme-card.theme-active {
  border-color: var(--accent);
  background: var(--accent-alpha-bg);
}
.theme-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.theme-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}
.theme-desc {
  font-size: 20rpx;
  color: var(--dim);
}

/* ===== 模式选择样式 ===== */
.mode-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 性别选择：水平排列 */
.gender-grid {
  flex-direction: row;
}
.gender-grid .mode-card {
  flex: 1;
  text-align: center;
}

.mode-card {
  padding: 30rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.mode-card.mode-active {
  border-color: var(--accent);
  background: var(--accent-alpha-bg);
  box-shadow: 0 0 20rpx rgba(0, 212, 170, 0.2);
}

.mode-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: var(--dim);
  margin-bottom: 16rpx;
}

.mode-features {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-feature {
  font-size: 24rpx;
  color: var(--text);
}

.mode-card.mode-active .mode-feature {
  color: var(--accent);
}

/* ===== 全屏遮罩引导样式 ===== */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 引导高亮区域 */
.guide-highlight {
  position: absolute;
  background: transparent;
  border-radius: 16rpx;
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.7);
  z-index: 1001;
  transition: all 0.3s ease;
}

/* 不同步骤的高亮位置 */
.guide-highlight-step1 {
  top: 200rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

.guide-highlight-step2 {
  top: 200rpx;
  left: 30rpx;
  right: 30rpx;
  height: 500rpx;
}

.guide-highlight-step3 {
  top: 200rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

.guide-highlight-step4 {
  top: 520rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

.guide-highlight-step5 {
  top: 200rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

.guide-highlight-step6 {
  top: 520rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

.guide-highlight-step7 {
  top: 200rpx;
  left: 30rpx;
  right: 30rpx;
  height: 300rpx;
}

/* 引导提示框 */
.guide-tooltip {
  position: absolute;
  bottom: 200rpx;
  left: 40rpx;
  right: 40rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 30rpx;
  z-index: 1002;
  animation: guideFadeIn 0.3s ease;
}

@keyframes guideFadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.guide-tooltip-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

.guide-tooltip-content {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.guide-tooltip-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.guide-step-indicator {
  font-size: 24rpx;
  color: var(--dim);
}

.guide-btns {
  display: flex;
  gap: 16rpx;
}

.guide-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.guide-btn-skip {
  background: transparent;
  border: 1rpx solid var(--border);
  color: var(--dim);
}

.guide-btn-next {
  background: var(--accent);
  color: var(--btn-text);
}
