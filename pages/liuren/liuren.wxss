/**
 * 小六壬占卜页样式
 */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 24rpx;
}

/* 选择区 */
.picker-section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.picker-item {
  flex: 1;
  text-align: center;
}

.picker-label {
  font-size: 22rpx;
  color: var(--dim);
  display: block;
  margin-bottom: 8rpx;
}

.picker-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  padding: 14rpx 0;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
}

/* 农历信息 */
.lunar-info {
  text-align: center;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
}

.lunar-text {
  font-size: 24rpx;
  color: var(--accent2);
  font-weight: 600;
}

.btn-divine {
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  color: var(--btn-text);
  border: none;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  width: 100%;
}

/* 区块 */
.section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

/* 三宫结果卡片 */
.god-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.god-card {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 6rpx solid var(--border);
}

.god-card.card-month {
  border-left-color: #4fc3f7;
}

.god-card.card-day {
  border-left-color: #ef5350;
}

.god-card.card-time {
  border-left-color: #ffd54f;
}

.god-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.god-card-tag {
  font-size: 20rpx;
  color: var(--dim);
  background: var(--card-bg);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.god-card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
}

.god-card-info {
  font-size: 22rpx;
  color: var(--dim);
  margin-bottom: 8rpx;
}

.god-card-poem {
  font-size: 24rpx;
  color: var(--text);
  margin-bottom: 8rpx;
  line-height: 1.6;
}

.god-card-meaning {
  font-size: 22rpx;
  color: var(--accent2);
  line-height: 1.5;
}

/* 卦辞总解 */
.summary-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.summary-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
}

/* 空状态 */
.empty-hint {
  text-align: center;
  color: var(--dim);
  font-size: 26rpx;
  padding: 80rpx 0;
}
