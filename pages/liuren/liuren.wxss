/**
 * 数算工具页面样式
 */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--dim);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 选择区 */
.picker-section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.picker-item {
  flex: 1;
  text-align: center;
}

.picker-label {
  font-size: 22rpx;
  color: var(--dim);
  display: block;
  margin-bottom: 8rpx;
}

.picker-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  padding: 14rpx 0;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
}

/* 农历信息 */
.lunar-info {
  text-align: center;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
}

.lunar-text {
  font-size: 24rpx;
  color: var(--accent2);
  font-weight: 600;
}

.btn-divine {
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  color: var(--btn-text);
  border: none;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  width: 100%;
}

/* 区块 */
.section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

/* 数字结果卡片 */
.number-cards {
  display: flex;
  gap: 16rpx;
}

.number-card {
  flex: 1;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 32rpx 12rpx;
  text-align: center;
  border-top: 6rpx solid var(--accent);
}

.number-tag {
  font-size: 24rpx;
  color: var(--dim);
  margin-bottom: 12rpx;
}

.number-value {
  font-size: 80rpx;
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
}

/* 使用说明 */
.summary-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.summary-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
}

/* 空状态 */
.empty-hint {
  text-align: center;
  color: var(--dim);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.disclaimer {
  text-align: center;
  color: var(--dim);
  font-size: 22rpx;
  padding: 32rpx 0 48rpx;
  opacity: 0.6;
}
