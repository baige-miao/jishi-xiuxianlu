/**
 * 八字流日运势页面样式
 * 复用 app.wxss CSS 变量
 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: var(--dim);
  line-height: 1.6;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 160rpx 0;
  color: var(--dim);
  font-size: 28rpx;
}

/* 今日运势标题 */
.today-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  padding: 20rpx 0 10rpx;
}

/* 卡片（补充页面特有样式，基础样式复用 app.wxss） */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border);
}
.card-body {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
}

/* 流日概要 */
.fortune-header {
  text-align: center;
  padding: 36rpx 28rpx;
}
.fortune-ganzhi {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 10rpx;
}
.fortune-shishen {
  font-size: 28rpx;
  color: var(--accent2);
  margin-bottom: 8rpx;
}
.fortune-strength {
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.fortune-level {
  font-size: 52rpx;
  font-weight: 900;
}

/* 吉凶等级颜色 */
.luck-daji {
  color: var(--gold);
}
.luck-ji {
  color: var(--success);
}
.luck-xiong {
  color: #ffa502;
}
.luck-daxiong {
  color: var(--danger);
}

/* 各柱对照 */
.pillars-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pillar-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx;
}
.pillar-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.pillar-label {
  font-size: 24rpx;
  color: var(--dim);
  width: 60rpx;
}
.pillar-ganzhi {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.pillar-shishen {
  font-size: 24rpx;
  color: var(--accent2);
  background: var(--accent2-alpha-bg);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.pillar-xiji {
  font-size: 22rpx;
  font-weight: 600;
}
.pillar-desc {
  font-size: 24rpx;
  color: var(--dim);
  line-height: 1.6;
  margin-top: 10rpx;
  padding-left: 76rpx;
}

/* 宜忌 */
.yiji-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.yiji-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.yiji-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.yi-row .yiji-icon {
  background: rgba(46, 213, 115, 0.15);
  color: var(--success);
  border: 1rpx solid rgba(46, 213, 115, 0.3);
}
.ji-row .yiji-icon {
  background: rgba(255, 71, 87, 0.15);
  color: var(--danger);
  border: 1rpx solid rgba(255, 71, 87, 0.3);
}
.yiji-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  padding-top: 10rpx;
}
.yiji-empty {
  text-align: center;
  padding: 20rpx;
}
