/**
 * 数据统计页样式
 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: var(--accent);
}

/* 概览卡片 */
.stat-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  width: calc(50% - 8rpx);
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--accent);
}
.stat-label {
  font-size: 22rpx;
  color: var(--dim);
  margin-top: 6rpx;
}

/* 区块 */
.section {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

/* TOP5 */
.top5-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.top5-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.top5-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--btn-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.top5-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}
.top5-count {
  font-size: 22rpx;
  color: var(--dim);
  flex-shrink: 0;
  width: 80rpx;
  text-align: right;
}
.top5-bar {
  width: 120rpx;
  height: 10rpx;
  background: var(--border);
  border-radius: 5rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.top5-bar-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 5rpx;
}

.empty-small {
  text-align: center;
  color: var(--dim);
  font-size: 24rpx;
  padding: 20rpx;
}

/* 图表区 */
.chart-area {
  overflow-x: auto;
}
.chart-bars {
  display: flex;
  gap: 8rpx;
  min-height: 200rpx;
  align-items: flex-end;
}
.chart-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 40rpx;
}
.chart-bar-wrapper {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.chart-bar {
  width: 80%;
  background: linear-gradient(to top, var(--accent), var(--accent2));
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.chart-date {
  font-size: 16rpx;
  color: var(--dim);
  margin-top: 6rpx;
  white-space: nowrap;
}
.chart-value {
  font-size: 18rpx;
  color: var(--accent);
  font-weight: 600;
}

/* 评级进度 */
.rating-current {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.rating-current-label {
  font-size: 24rpx;
  color: var(--dim);
}
.rating-current-value {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--accent2);
}
.rating-current-sum {
  font-size: 24rpx;
  color: var(--dim);
}
.rating-bar-section {
  margin-bottom: 20rpx;
}
.rating-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--dim);
  margin-bottom: 6rpx;
}
.rating-bar-outer {
  height: 14rpx;
  background: var(--border);
  border-radius: 7rpx;
  overflow: hidden;
}
.rating-bar-inner {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, var(--accent2), var(--accent));
  transition: width 0.4s ease;
}
.rating-bar-pct {
  text-align: right;
  font-size: 20rpx;
  color: var(--dim);
  margin-top: 4rpx;
}
.rating-tiers {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.rating-tier {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--border);
  background: var(--card-bg);
  min-width: 80rpx;
}
.rating-tier.active {
  border-color: var(--accent2);
  background: var(--accent2-alpha-bg);
}
.tier-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text);
}
.tier-range {
  font-size: 16rpx;
  color: var(--dim);
}
