/**
 * 全局样式 - 主题系统
 * 通过CSS变量实现4种主题切换
 */

/* ===== 默认主题（暗黑） ===== */
page {
  --bg: #0a0a14;
  --card-bg: #141428;
  --border: #252545;
  --accent: #00d4aa;
  --accent2: #7b68ee;
  --gold: #f0c040;
  --text: #e0e0e0;
  --dim: #888888;
  --danger: #ff4757;
  --success: #2ed573;
  --input-bg: #12121f;
  --btn-text: #000;
  --mask-bg: rgba(0, 0, 0, 0.6);
  --accent-alpha-bg: rgba(0, 212, 170, 0.1);
  --accent-alpha-border: rgba(0, 212, 170, 0.3);
  --accent2-alpha-bg: rgba(169, 92, 232, 0.1);
  --accent2-alpha-border: rgba(169, 92, 232, 0.3);
  --spirit-color: #3742fa;
  --spirit-alpha-bg: rgba(55, 66, 250, 0.1);
  --spirit-alpha-border: rgba(55, 66, 250, 0.3);
  --gold-alpha-bg: rgba(240, 192, 64, 0.05);
  --gold-alpha-mid: rgba(240, 192, 64, 0.15);
  --gold-alpha-border: rgba(240, 192, 64, 0.3);
  --reminder-bg: rgba(255, 165, 2, 0.08);
  --reminder-border: rgba(255, 165, 2, 0.25);
  --book-bg: #0a0a18;
  /* 数值颜色（属性值分段） */
  --val-10: #ff4757;
  --val-30: #ffa502;
  --val-60: #1e90ff;
  --val-100: #2ed573;
  --val-200: #a55eea;
  --val-500: #3742fa;
  --val-max: #f0c040;
  /* 任务类型颜色 */
  --task-daily: #2ed573;
  --task-special: #a55eea;
  --task-emergency: #ff4757;
  --task-phase: #3742fa;
  /* 卡片设计变量 */
  --card-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  --card-radius: 24rpx;
  --card-padding: 32rpx;
  --section-gap: 24rpx;

  background-color: var(--bg);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 暗黑主题（默认） ===== */
.theme-dark {
  color: var(--text);
}

/* ===== 修仙复古主题 ===== */
.theme-ancient,
.theme-ancient page {
  color: var(--text);
  --bg: #f5e6c8;
  --card-bg: #e8d5a3;
  --border: #c4a35a;
  --accent: #8b4513;
  --accent2: #d4a017;
  --gold: #b8860b;
  --text: #3e2723;
  --dim: #8d6e63;
  --danger: #c0392b;
  --success: #27ae60;
  --input-bg: #dcc89a;
  --btn-text: #fff;
  --mask-bg: rgba(0, 0, 0, 0.5);
  --accent-alpha-bg: rgba(139, 69, 19, 0.1);
  --accent-alpha-border: rgba(139, 69, 19, 0.3);
  --accent2-alpha-bg: rgba(212, 160, 23, 0.1);
  --accent2-alpha-border: rgba(212, 160, 23, 0.3);
  --spirit-color: #6b3a0a;
  --spirit-alpha-bg: rgba(107, 58, 10, 0.1);
  --spirit-alpha-border: rgba(107, 58, 10, 0.3);
  --gold-alpha-bg: rgba(184, 134, 11, 0.05);
  --gold-alpha-mid: rgba(184, 134, 11, 0.15);
  --gold-alpha-border: rgba(184, 134, 11, 0.3);
  --reminder-bg: rgba(139, 69, 19, 0.08);
  --reminder-border: rgba(139, 69, 19, 0.25);
  --book-bg: #c4a35a;
  --val-10: #c0392b;
  --val-30: #b35900;
  --val-60: #1a5276;
  --val-100: #1e7a3a;
  --val-200: #6b2d8b;
  --val-500: #2c3e50;
  --val-max: #8b6914;
  --task-daily: #1e7a3a;
  --task-special: #6b2d8b;
  --task-emergency: #c0392b;
  --task-phase: #2c3e50;
  --card-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* ===== 轻量简约主题 ===== */
