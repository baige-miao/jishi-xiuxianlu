  --bg: #f8f9fa;
  --card-bg: #ffffff;
  --border: #e0e0e0;
  --accent: #4a90d9;
  --accent2: #7c3aed;
  --gold: #f59e0b;
  --text: #1a1a2e;
  --dim: #999999;
  --danger: #ef4444;
  --success: #22c55e;
  --input-bg: #f0f0f0;
  --btn-text: #fff;
  --mask-bg: rgba(0, 0, 0, 0.3);
  --accent-alpha-bg: rgba(74, 144, 217, 0.1);
  --accent-alpha-border: rgba(74, 144, 217, 0.3);
  --accent2-alpha-bg: rgba(124, 58, 237, 0.1);
  --accent2-alpha-border: rgba(124, 58, 237, 0.3);
  --spirit-color: #4a90d9;
