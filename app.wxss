/* ===== 赛博朋克主题 ===== */
.theme-cyber,
.theme-cyber page {
  color: var(--text);
  --bg: #0d0221;
  --card-bg: #150050;
  --border: #333366;
  --accent: #ff00ff;
  --accent2: #00ffff;
  --gold: #ffff00;
  --text: #e0e0ff;
  --dim: #8888aa;
  --danger: #ff0055;
  --success: #00ff88;
  --input-bg: #1a0044;
  --btn-text: #000;
  --mask-bg: rgba(0, 0, 0, 0.7);
  --accent-alpha-bg: rgba(255, 0, 255, 0.1);
  --accent-alpha-border: rgba(255, 0, 255, 0.3);
  --accent2-alpha-bg: rgba(0, 255, 255, 0.1);
  --accent2-alpha-border: rgba(0, 255, 255, 0.3);
  --spirit-color: #00ffff;
  --spirit-alpha-bg: rgba(0, 255, 255, 0.1);
  --spirit-alpha-border: rgba(0, 255, 255, 0.3);
  --gold-alpha-bg: rgba(255, 255, 0, 0.05);
  --gold-alpha-mid: rgba(255, 255, 0, 0.15);
  --gold-alpha-border: rgba(255, 255, 0, 0.3);
  --reminder-bg: rgba(255, 255, 0, 0.08);
  --reminder-border: rgba(255, 255, 0, 0.25);
  --book-bg: #0a0020;
  --val-10: #ff0055;
  --val-30: #ff6600;
  --val-60: #00ccff;
  --val-100: #00ff88;
  --val-200: #cc44ff;
  --val-500: #4466ff;
  --val-max: #ffff00;
  --task-daily: #00ff88;
  --task-special: #cc44ff;
  --task-emergency: #ff0055;
  --task-phase: #4466ff;
  --card-shadow: 0 4rpx 20rpx rgba(255, 0, 255, 0.08);
}

/* ===== 通用样式 ===== */

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 通用按钮 */
.btn-primary {
  background: var(--accent);
  color: var(--btn-text);
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--accent);
  color: var(--accent);
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  text-align: center;
}

.btn-danger {
  background: transparent;
  border: 1rpx solid var(--danger);
  color: var(--danger);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  text-align: center;
}

/* 区域标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 30rpx 0 16rpx;
  color: var(--accent);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* 隐藏 */
.hidden {
  display: none;
}

/* 数值颜色类（通过class而非style应用，兼容小程序） */
.val-10 { color: var(--val-10); }
.val-30 { color: var(--val-30); }
.val-60 { color: var(--val-60); }
.val-100 { color: var(--val-100); }
.val-200 { color: var(--val-200); }
.val-500 { color: var(--val-500); }
.val-max { color: var(--val-max); }

/* 任务类型颜色类 */
.task-daily { color: var(--task-daily); }
.task-special { color: var(--task-special); }
.task-emergency { color: var(--task-emergency); }
.task-phase { color: var(--task-phase); }

/* 背景色类（用于进度条等） */
.val-bg-10 { background-color: var(--val-10); }
.val-bg-30 { background-color: var(--val-30); }
.val-bg-60 { background-color: var(--val-60); }
.val-bg-100 { background-color: var(--val-100); }
.val-bg-200 { background-color: var(--val-200); }
.val-bg-500 { background-color: var(--val-500); }
.val-bg-max { background-color: var(--val-max); }

/* 语义颜色类 */
.text-gold { color: var(--gold); }
.text-accent { color: var(--accent); }
.text-accent2 { color: var(--accent2); }
.text-dim { color: var(--dim); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }
