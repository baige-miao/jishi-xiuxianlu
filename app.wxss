  --spirit-alpha-border: rgba(74, 144, 217, 0.3);
  --gold-alpha-bg: rgba(245, 158, 11, 0.05);
  --gold-alpha-mid: rgba(245, 158, 11, 0.15);
  --gold-alpha-border: rgba(245, 158, 11, 0.3);
  --reminder-bg: rgba(245, 158, 11, 0.08);
  --reminder-border: rgba(245, 158, 11, 0.25);
  --book-bg: #e8e4de;
  --val-10: #dc2626;
  --val-30: #d97706;
  --val-60: #2563eb;
  --val-100: #16a34a;
  --val-200: #7c3aed;
  --val-500: #1d4ed8;
  --val-max: #b45309;
  --task-daily: #16a34a;
  --task-special: #7c3aed;
  --task-emergency: #dc2626;
  --task-phase: #1d4ed8;
  --card-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
